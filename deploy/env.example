# Copy to deploy/.env on the server (the file is gitignored) and fill every value.
# `docker compose -f deploy/docker-compose.prod.yml` reads this file for both substitution and the containers.

# Public host name served by Caddy; DNS A/AAAA record must point to the server first.
DOMAIN=wiki.example.com

# Host port the app is bound to (loopback only) — Caddy proxies to it over the compose network anyway.
APP_PORT=3000

# Postgres runs in its own container and is not published to the host.
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=jarvis

# The browser-facing origin: https, same host as DOMAIN. Secure cookies require https.
SERVER_URL=https://wiki.example.com
CLIENT_URL=https://wiki.example.com
# Inside the compose network the host is `db`, and the password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://jarvis:change-me-to-a-long-random-string@db:5432/jarvis

# Basic-auth credentials for /openapi.json, /scalar, /swagger.
OPENAPI_CREDENTIALS=admin:change-me-too

# better-auth signing key: 32+ chars, never rotate casually — a new value invalidates every session.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# First admin, created (or promoted) on startup. After the first deploy you can remove the line.
ADMIN_CREDENTIALS=admin@example.com:change-me-please

