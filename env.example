SERVER_PORT=3000
CLIENT_PORT=3001
SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:3001
# Postgres from `docker compose up -d db` (user/password/db match docker-compose.yml)
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
OPENAPI_CREDENTIALS=admin:admin
# better-auth signing key: at least 32 chars, stable across restarts (`openssl rand -hex 32`)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# first admin, created or promoted on startup (`email:password`)
ADMIN_CREDENTIALS=admin@example.com:change-me-please