{
  "name": "my-app",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "point0 dev --hot",
    "generate": "point0 generate",
    "mcp:project": "point0-project-mcp --meta ./src/generated/point0/meta.ts",
    "mcp:docs": "point0-docs-mcp",
    "build": "point0 build",
    "start": "cross-env NODE_ENV=production bun run ./dist/server/index.server.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down --volumes",
    "clean": "rimraf dist",
    "types": "tsc --noEmit",
    "prisma:reset": "cross-env NODE_ENV=development prisma migrate reset",
    "prisma:generate": "cross-env NODE_ENV=development prisma generate",
    "prisma:migrate:dev": "cross-env NODE_ENV=development prisma migrate dev",
    "prisma:migrate:deploy": "cross-env NODE_ENV=development prisma migrate deploy",
    "seed": "cross-env NODE_ENV=development bun --preload ./src/preload.ts ./src/lib/seed.ts",
    "setup": "bun run prisma:migrate:deploy && bun run prisma:generate && point0 generate && bun run seed"
  },
  "dependencies": {
    "@1gr14/error0": "^0.4.8",
    "@1gr14/flat": "^0.1.4",
    "@1gr14/route0": "^0.4.1",
    "@mdxeditor/editor": "^4.3.4",
    "@point0/basic-auth": "^0.4.2",
    "@point0/cache-control": "^0.4.2",
    "@point0/compiler": "^0.4.2",
    "@point0/compress": "^0.4.2",
    "@point0/core": "^0.4.2",
    "@point0/engine": "^0.4.2",
    "@point0/openapi": "^0.4.2",
    "@point0/react-dom": "^0.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@unhead/react": "^3.2.3",
    "better-auth": "^1.7.14",
    "bun-plugin-tailwind": "^0.1.2",
    "dotenv": "^17.4.2",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "openapi-types": "^12.0.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "unhead": "^3.2.3",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@point0/docs": "^0.4.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@faker-js/faker": "^10.4.0",
    "cross-env": "^10.0.0",
    "ncp": "^2.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "prettier": "^3.9.6"
  }
}
