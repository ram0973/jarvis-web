# Copy to .kamal/secrets (gitignored) and fill in. Kamal reads this file, not .env.

# A GitHub token with `write:packages` (GHCR is the image registry this config pushes to).
KAMAL_REGISTRY_PASSWORD=ghp_replace_me

# Use `openssl rand -hex 24`: hex avoids the URL-encoding of `@`, `:`, `/` in DATABASE_URL below.
POSTGRES_PASSWORD=replace_me_hex

# The accessory container is `jarvis-web-db` (Kamal names it `<service>-<accessory>`); the password must match
# POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://jarvis:replace_me_hex@jarvis-web-db:5432/jarvis

# 32+ chars, never rotate casually — a new value signs everyone out.
BETTER_AUTH_SECRET=replace_me_with_openssl_rand_hex_32

# Basic auth for /openapi.json, /scalar, /swagger.
OPENAPI_CREDENTIALS=admin:replace_me

# First admin, created (or promoted) on startup; remove the line after the first deploy.
ADMIN_CREDENTIALS=admin@example.com:replace_me_please
